dialogue main {
    set speaker "Glibness"
    say "This dialogue contains some choices."
    say "What's your favorite animal?"

    choose {
        choice "Dog" {
            say "Wow, I like dogs too!"
        }
        choice "Cat" {
            say "Okay..."
            say "I prefer dogs myself..."
        }
        choice "Penguin" {
            say "Penguins?! Now that's a surprise!"
            say "I can talk all day about penguins!"
            say "Did you know that penguins are actually birds?!"
        }
    }

    say "Thank you for answering the question."
}
